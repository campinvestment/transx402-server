{
  "name": "@transx402/server",
  "version": "0.1.1",
  "description": "IDRX x402 server helpers for merchants — 402 responses, payment headers, facilitate",
  "type": "module",
  "license": "MIT",
  "author": "Camp Investment",
  "keywords": [
    "x402",
    "transx402",
    "payments",
    "idr",
    "idrx",
    "server",
    "facilitator"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/campinvestment/transx402-server.git"
  },
  "bugs": {
    "url": "https://github.com/campinvestment/transx402-server/issues"
  },
  "homepage": "https://github.com/campinvestment/transx402-server#readme",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && esbuild src/index.ts --bundle --format=cjs --platform=node --target=es2020 --packages=external --outfile=dist/index.cjs",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm test && pnpm build"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "esbuild": "0.27.4",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10"
  }
}
